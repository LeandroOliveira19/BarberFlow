<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS (servidor da UA): devolve as respostas de erro JSON da API tal como o PHP as gera,
  em vez de as substituir pelas páginas de erro HTML do IIS (404/409/422/500...).
  Se o servidor tiver esta secção bloqueada, o IIS responde 500.19 em toda a pasta:
  nesse caso apaga este ficheiro e avisa (a API funciona, mas os erros podem chegar em HTML).
-->
<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
